# Vectorize Hindsight Memory Configuration
HINDSIGHT_API_URL=http://localhost:8888
HINDSIGHT_API_KEY=your_hindsight_api_key_here

# Google Gemini LLM Configuration (https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Google Calendar OAuth2 Configuration
GOOGLE_CALENDAR_CREDENTIALS_FILE=credentials.json
GOOGLE_CALENDAR_TOKEN_FILE=token.json

# n8n Automation Webhooks (Google Calendar, Gmail & Google Sheets)
N8N_CREATE_MEETING_WEBHOOK_URL=https://vijaysiddhath.app.n8n.cloud/webhook/create-meeting
N8N_SYNC_TASKS_WEBHOOK_URL=https://vijaysiddhath.app.n8n.cloud/webhook/meeting-sync-tasks

# Server Settings
HOST=0.0.0.0
PORT=8000
